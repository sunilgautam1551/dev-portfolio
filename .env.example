# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Resend (contact form email delivery) ---
# https://resend.com — free tier: 3,000 emails/month, 100/day.
# Without this, the contact form validates client-side but the API route
# returns a clear "not configured" error instead of sending.
RESEND_API_KEY=

# Where contact-form notifications actually land. Defaults to the identity.email
# shown publicly on the site — override this if, e.g., your Resend account isn't
# on a verified domain yet, since sandbox mode only allows sending to the
# account's own registered email.
CONTACT_NOTIFICATION_EMAIL=

# --- Upstash Redis (guestbook storage + rate limiting) ---
# https://console.upstash.com — free tier, REST API, no idle-pause.
# Without these, the guestbook is a no-op ([] on read, 503 on write) and
# rate limiting on the contact form is skipped entirely.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile (bot protection on contact + guestbook forms) ---
# https://dash.cloudflare.com/?to=/:account/turnstile — free.
# Optional: both forms work without it (Turnstile step is skipped), but
# rate limiting + honeypot alone are weaker spam defenses.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Admin guestbook moderation (/admin/guestbook) ---
# HTTP Basic Auth credentials — required to access the moderation page at all.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Site URL (used in metadata, sitemap, JSON-LD, OG tags) ---
# Set to the real production domain once deployed. Must include the scheme
# (https://) — a bare domain will fail metadata generation at build time.
NEXT_PUBLIC_SITE_URL=https://sunilgautam.dev
